# 后端数据库凭据（mycli 自动读取 MYSQL_PWD，redis-cli 自动读取 REDISCLI_AUTH，
# iredis 自动读取 IREDIS_URL，连接时不用在命令行写密码，避免进 shell history）
set -gx BACKEND_MYSQL_HOST ""
set -gx BACKEND_MYSQL_PORT "3306"
set -gx BACKEND_MYSQL_USER ""
set -gx MYSQL_PWD ""
set -gx BACKEND_REDIS_HOST ""
set -gx BACKEND_REDIS_PORT "6379"
set -gx BACKEND_REDIS_PWD ""

set -gx OPENROUTER_API_KEY ""
set -gx DEEPSEEK_API_KEY ""
set -gx ZHIPUAI_API_KEY ""
set -gx TAVILY_API_KEY ""

# Claude Code API 中转站配置（claude 包的 settings.json 不含 env，敏感配置走这里）
set -gx ANTHROPIC_AUTH_TOKEN ""
set -gx ANTHROPIC_BASE_URL ""
set -gx ANTHROPIC_MODEL ""
set -gx ANTHROPIC_DEFAULT_OPUS_MODEL ""
set -gx ANTHROPIC_DEFAULT_OPUS_MODEL_NAME ""
set -gx ANTHROPIC_DEFAULT_SONNET_MODEL ""
set -gx ANTHROPIC_DEFAULT_SONNET_MODEL_NAME ""
set -gx ANTHROPIC_DEFAULT_HAIKU_MODEL ""
set -gx ANTHROPIC_DEFAULT_HAIKU_MODEL_NAME ""
set -gx ANTHROPIC_DEFAULT_FABLE_MODEL ""
set -gx ANTHROPIC_DEFAULT_FABLE_MODEL_NAME ""
